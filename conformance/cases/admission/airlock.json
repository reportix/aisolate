{
  "description": "Gate 2 (the airlock pod, AirlockAdmissionService) and gate 5's admission (the tool server, GovernedQueryService.admits): both are Principal.admissionFailure(roles, callers, clients) over the validated token's claims, roles read at realm_access.roles (a list, or one string as one role; non-string entries are no roles). roles = the space's access.roles then the airlock's own access.roles (distinct); callers = the airlock's access.callers; clients = the airlock's access.clients (absent: none). A token without an email claim whose azp is one of clients is a machine client and admitted (exact, '*' is no wildcard, roles and callers not consulted); every other token is judged by roles then callers: admitted when one of its roles is listed (exact, case-sensitive, '*' is no wildcard) and its azp is a caller ('*' admits any present azp). An e-mail is not needed. An admitted request goes on; a refused one is 403 problem detail 'forbidden' at the airlock with one refusal audit event (reason role|client), and an empty result at the tool server.",
  "space": {"name": "hr-acme", "roles": ["ceo", "Finance"]},
  "airlocks": {
    "hr": {"roles": ["employee"], "callers": ["*"]},
    "chat-only": {"roles": ["employee"], "callers": ["acme-chat"]},
    "two-clients": {"roles": [], "callers": ["acme-chat", "partner-app"]},
    "no-callers": {"roles": ["employee"], "callers": []},
    "star-role": {"roles": ["*"], "callers": ["*"]},
    "finance": {"roles": ["auditor"], "callers": ["*"]},
    "machine": {"roles": ["employee"], "callers": ["acme-chat"], "clients": ["knime"]},
    "star-client": {"roles": [], "callers": ["*"], "clients": ["*"]}
  },
  "cases": [
    {"id": "space-role-admitted-everywhere", "airlock": "finance", "claims": {"sub": "u-1", "email": "nora@example.com", "azp": "acme-chat", "realm_access": {"roles": ["ceo"]}}, "expect": {"admitted": true}},
    {"id": "airlock-own-role-admitted", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": ["offline_access", "employee"]}}, "expect": {"admitted": true}},
    {"id": "role-case-sensitive", "airlock": "hr", "claims": {"sub": "u-1", "email": "nora@example.com", "azp": "acme-chat", "realm_access": {"roles": ["Ceo"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "listed-role-case-kept", "airlock": "hr", "claims": {"sub": "u-3", "email": "ada@example.com", "azp": "acme-chat", "realm_access": {"roles": ["finance"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "role-on-neither-list", "airlock": "hr", "claims": {"sub": "u-4", "email": "jasmine@example.com", "azp": "acme-chat", "realm_access": {"roles": ["intern", "aisolate-admin"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "role-of-another-airlock-only", "airlock": "hr", "claims": {"sub": "u-5", "email": "lea@example.com", "azp": "acme-chat", "realm_access": {"roles": ["auditor"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "airlock-without-roles-admits-the-space-roles-only", "airlock": "two-clients", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "no-roles-claim", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "single-string-roles-claim-admitted", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": "employee"}}, "expect": {"admitted": true}},
    {"id": "non-string-roles-are-no-roles", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": [["employee"], 7, {"employee": true}]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "roles-only-at-the-roles-claim", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "roles": ["employee"], "resource_access": {"acme-chat": {"roles": ["employee"]}}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "role-not-trimmed", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": [" employee"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "email-not-needed", "airlock": "hr", "claims": {"sub": "u-6", "azp": "acme-chat", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": true}},
    {"id": "star-is-no-role-wildcard", "airlock": "star-role", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "role-checked-before-client", "airlock": "chat-only", "claims": {"sub": "u-4", "email": "jasmine@example.com", "azp": "partner-app", "realm_access": {"roles": ["intern"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "listed-role-unlisted-caller", "airlock": "chat-only", "claims": {"sub": "u-1", "email": "nora@example.com", "azp": "partner-app", "realm_access": {"roles": ["ceo"]}}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "star-caller-admits-any-client", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "partner-app", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": true}},
    {"id": "listed-caller-admitted", "airlock": "chat-only", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": true}},
    {"id": "caller-case-sensitive", "airlock": "chat-only", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "Acme-Chat", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "no-azp-refused-even-with-star", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "no-callers-admits-no-client", "airlock": "no-callers", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "space-role-through-second-listed-client", "airlock": "two-clients", "claims": {"sub": "u-3", "email": "ada@example.com", "azp": "partner-app", "realm_access": {"roles": ["Finance"]}}, "expect": {"admitted": true}},
    {"id": "non-string-azp-is-no-client", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": 7, "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "listed-machine-client-admitted", "airlock": "machine", "claims": {"sub": "sa-knime", "azp": "knime"}, "expect": {"admitted": true}},
    {"id": "machine-client-ignores-roles", "airlock": "machine", "claims": {"sub": "sa-knime", "azp": "knime", "realm_access": {"roles": ["nobody"]}}, "expect": {"admitted": true}},
    {"id": "non-string-email-is-no-email", "airlock": "machine", "claims": {"sub": "sa-knime", "email": ["ops@example.com"], "azp": "knime"}, "expect": {"admitted": true}},
    {"id": "unlisted-machine-client-refused", "airlock": "machine", "claims": {"sub": "sa-n8n", "azp": "n8n"}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "machine-client-of-another-airlock-only", "airlock": "hr", "claims": {"sub": "sa-knime", "azp": "knime"}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "person-through-listed-client-needs-listed-role", "airlock": "machine", "claims": {"sub": "u-5", "email": "mallory@example.com", "azp": "knime", "realm_access": {"roles": ["intern"]}}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "person-through-listed-client-needs-listed-caller", "airlock": "machine", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "knime", "realm_access": {"roles": ["employee"]}}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "client-id-case-sensitive", "airlock": "machine", "claims": {"sub": "sa-knime", "azp": "KNIME"}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "star-is-no-client-wildcard", "airlock": "star-client", "claims": {"sub": "sa-any", "azp": "anything"}, "expect": {"admitted": false, "reason": "role"}},
    {"id": "no-email-no-azp-refused", "airlock": "machine", "claims": {"sub": "sa-none"}, "expect": {"admitted": false, "reason": "role"}}
  ]
}
