{
  "description": "Gate 2 (the airlock pod) and gate 5's admission (the tool server, GovernedQueryService.admits): both are Principal.admissionFailure(users, callers, clients) over the validated token's claims. users = the space's access.users then the airlock's own access.users (distinct); callers = the airlock's access.callers; clients = the airlock's access.clients (absent: none). A token without an email claim whose azp is one of clients is a machine client and admitted (exact, '*' is no wildcard, callers not consulted); every other token is judged by users then callers, so a person signing in through a listed client still needs a listed email and a listed caller. An admitted request goes on; a refused one is 403 problem detail 'forbidden' at the airlock with one refusal audit event (reason user|client), and an empty result at the tool server.",
  "space": {"name": "hr-acme", "users": ["nora@example.com", "Ada.Admin@Example.com"]},
  "airlocks": {
    "hr": {"users": ["eric@example.com"], "callers": ["*"]},
    "chat-only": {"users": ["eric@example.com"], "callers": ["acme-chat"]},
    "two-clients": {"users": [], "callers": ["acme-chat", "partner-app"]},
    "no-callers": {"users": ["eric@example.com"], "callers": []},
    "star-user": {"users": ["*"], "callers": ["*"]},
    "finance": {"users": ["lea@example.com"], "callers": ["*"]},
    "machine": {"users": ["eric@example.com"], "callers": ["acme-chat"], "clients": ["knime"]},
    "star-client": {"users": [], "callers": ["*"], "clients": ["*"]}
  },
  "cases": [
    {"id": "space-user-admitted-everywhere", "airlock": "hr", "claims": {"sub": "u-1", "email": "nora@example.com", "azp": "acme-chat"}, "expect": {"admitted": true}},
    {"id": "airlock-own-user-admitted", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat"}, "expect": {"admitted": true}},
    {"id": "token-email-case-ignored", "airlock": "hr", "claims": {"sub": "u-1", "email": "Nora@Example.Com", "azp": "acme-chat"}, "expect": {"admitted": true}},
    {"id": "listed-email-case-ignored", "airlock": "hr", "claims": {"sub": "u-3", "email": "ada.admin@example.com", "azp": "acme-chat"}, "expect": {"admitted": true}},
    {"id": "user-on-neither-list", "airlock": "hr", "claims": {"sub": "u-4", "email": "jasmine@example.com", "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "user-of-another-airlock-only", "airlock": "finance", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "no-email-claim", "airlock": "hr", "claims": {"sub": "u-5", "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "email-not-trimmed", "airlock": "hr", "claims": {"sub": "u-1", "email": " nora@example.com", "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "star-is-no-user-wildcard", "airlock": "star-user", "claims": {"sub": "u-4", "email": "jasmine@example.com", "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "role-does-not-admit", "airlock": "hr", "claims": {"sub": "u-4", "email": "jasmine@example.com", "azp": "acme-chat", "realm_access": {"roles": ["aisolate-admin", "ceo"]}}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "star-caller-admits-any-client", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "partner-app"}, "expect": {"admitted": true}},
    {"id": "listed-caller-admitted", "airlock": "chat-only", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat"}, "expect": {"admitted": true}},
    {"id": "unlisted-caller-refused", "airlock": "chat-only", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "partner-app"}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "caller-case-sensitive", "airlock": "chat-only", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "Acme-Chat"}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "no-azp-refused-even-with-star", "airlock": "hr", "claims": {"sub": "u-2", "email": "eric@example.com"}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "no-callers-admits-no-client", "airlock": "no-callers", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "space-user-through-second-listed-client", "airlock": "two-clients", "claims": {"sub": "u-1", "email": "nora@example.com", "azp": "partner-app"}, "expect": {"admitted": true}},
    {"id": "user-checked-before-client", "airlock": "chat-only", "claims": {"sub": "u-4", "email": "jasmine@example.com", "azp": "partner-app"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "non-string-email-is-no-email", "airlock": "hr", "claims": {"sub": "u-6", "email": ["nora@example.com"], "azp": "acme-chat"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "non-string-azp-is-no-client", "airlock": "hr", "claims": {"sub": "u-1", "email": "nora@example.com", "azp": 7}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "listed-machine-client-admitted", "airlock": "machine", "claims": {"sub": "sa-knime", "azp": "knime"}, "expect": {"admitted": true}},
    {"id": "unlisted-machine-client-refused", "airlock": "machine", "claims": {"sub": "sa-n8n", "azp": "n8n"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "machine-client-of-another-airlock-only", "airlock": "hr", "claims": {"sub": "sa-knime", "azp": "knime"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "person-through-listed-client-needs-listed-email", "airlock": "machine", "claims": {"sub": "u-5", "email": "mallory@example.com", "azp": "knime"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "person-through-listed-client-needs-listed-caller", "airlock": "machine", "claims": {"sub": "u-2", "email": "eric@example.com", "azp": "knime"}, "expect": {"admitted": false, "reason": "client"}},
    {"id": "client-id-case-sensitive", "airlock": "machine", "claims": {"sub": "sa-knime", "azp": "KNIME"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "star-is-no-client-wildcard", "airlock": "star-client", "claims": {"sub": "sa-any", "azp": "anything"}, "expect": {"admitted": false, "reason": "user"}},
    {"id": "no-email-no-azp-refused", "airlock": "machine", "claims": {"sub": "sa-none"}, "expect": {"admitted": false, "reason": "user"}}
  ]
}
