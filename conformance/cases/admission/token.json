{
  "description": "Gates 1 and 4 (libs/identity SecurityConfig over Spring Boot's resource-server defaults): the bearer token is a JWS from the issuer's JWKS, iss equal to the configured issuer, aud containing the configured audience, exp and nbf checked with 60 s clock skew. Any failure is 401 with WWW-Authenticate: Bearer resource_metadata=\"<public url>/.well-known/oauth-protected-resource\" and body {\"status\":401,\"title\":\"Unauthorized\"} (application/problem+json), before admission, the model or the data. Times are seconds relative to now. signed_by: issuer_key (a key in the issuer's JWKS, kid 'conformance'), other_key (an RSA key the JWKS does not hold, same kid), none (alg none, empty signature), hs256_public (HS256 keyed with the issuer's public key bytes).",
  "issuer": "https://idp.example/realms/conformance",
  "audience": "aisolate",
  "base_claims": {"iss": "https://idp.example/realms/conformance", "aud": "aisolate", "sub": "u-1", "email": "nora@example.com", "azp": "acme-chat", "iat": -10, "exp": 300},
  "cases": [
    {"id": "valid", "signed_by": "issuer_key", "claims": {}, "expect": "valid"},
    {"id": "audience-in-a-list", "signed_by": "issuer_key", "claims": {"aud": ["account", "aisolate"]}, "expect": "valid"},
    {"id": "no-token", "signed_by": null, "claims": {}, "expect": 401},
    {"id": "unknown-signing-key", "signed_by": "other_key", "claims": {}, "expect": 401},
    {"id": "alg-none", "signed_by": "none", "claims": {}, "expect": 401},
    {"id": "hs256-with-public-key", "signed_by": "hs256_public", "claims": {}, "expect": 401},
    {"id": "other-audience", "signed_by": "issuer_key", "claims": {"aud": "other-app"}, "expect": 401},
    {"id": "no-audience", "signed_by": "issuer_key", "claims": {"aud": null}, "expect": 401},
    {"id": "other-issuer", "signed_by": "issuer_key", "claims": {"iss": "https://idp.example/realms/other"}, "expect": 401},
    {"id": "issuer-with-trailing-slash", "signed_by": "issuer_key", "claims": {"iss": "https://idp.example/realms/conformance/"}, "expect": 401},
    {"id": "expired-within-skew", "signed_by": "issuer_key", "claims": {"iat": -200, "exp": -30}, "expect": "valid"},
    {"id": "expired-beyond-skew", "signed_by": "issuer_key", "claims": {"iat": -200, "exp": -120}, "expect": 401},
    {"id": "not-yet-valid-within-skew", "signed_by": "issuer_key", "claims": {"nbf": 30}, "expect": "valid"},
    {"id": "not-yet-valid-beyond-skew", "signed_by": "issuer_key", "claims": {"nbf": 120}, "expect": 401},
    {"id": "no-subject", "signed_by": "issuer_key", "claims": {"sub": null}, "expect": 401},
    {"id": "malformed", "signed_by": "issuer_key", "raw": "not.a.jwt", "expect": 401}
  ]
}
