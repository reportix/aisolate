{
  "name": "aisolate-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "libs/ui",
    "apps/frontend",
    "apps/chat"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --check apps/frontend apps/chat libs/ui",
    "format:write": "prettier --write apps/frontend apps/chat libs/ui"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0",
    "vitest": "^5"
  }
}
