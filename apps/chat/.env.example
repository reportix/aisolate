# The AIsolate URL: the release host whose ingress serves the airlocks (http://aisolate.localhost in the
# minikube demo), not the backend's. The chat lists the airlocks there and discovers the identity provider
# from it. Optionally, the airlock id to preselect.
NEXT_PUBLIC_AISOLATE_URL=http://aisolate.localhost
NEXT_PUBLIC_AISOLATE_AIRLOCK_ID=
