# Example values; replace them for your cluster. `aisolate create` copies this
# file to .env, which stays out of git.
# Where AIsolate runs: the AIsolate UI's API, which `aisolate deploy` calls.
AISOLATE_ENDPOINT=http://localhost:8080
# The space this project deploys into, created in the AIsolate UI. The airlock is created
# or updated from aisolate.yaml on every deploy; a field it leaves out keeps the UI's value.
AISOLATE_SPACE=${SPACE}
# No credentials: the data source clients and the LLMs are the admin's, set in the
# AIsolate UI.
