  <xs:element name="ToolCallLineItems" id="aisolate_ToolCallLineItems" type="xbrli:stringItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration" nillable="true" abstract="true"/>
  <xs:element name="VerifierLineItems" id="aisolate_VerifierLineItems" type="xbrli:stringItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration" nillable="true" abstract="true"/>
