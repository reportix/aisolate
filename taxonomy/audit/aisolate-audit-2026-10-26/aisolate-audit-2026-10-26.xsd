<?xml version="1.0" encoding="UTF-8"?>
<!-- AIsolate Audit taxonomy 2026-10-26: one row per question put to an airlock, one per tool call, one per verifier run. (c) AIsolate. -->
<xs:schema targetNamespace="https://aisolate.ai/xbrl/audit/2026-10-26" elementFormDefault="qualified" attributeFormDefault="unqualified"
