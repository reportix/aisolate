{
  "realm": "aisolate",
  "displayName": "AIsolate (operators: admins and developers)",
  "displayNameHtml": "AIsolate<br><small>admins and developers</small>",
  "loginTheme": "aisolate-ui",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "offlineSessionIdleTimeout": 7776000,
  "offlineSessionMaxLifespanEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "aisolate-admin",
        "description": "AIsolate UI: creates spaces and names the developers and the roles that may ask; may do everything"
      },
      {
        "name": "aisolate-auditor",
        "description": "AIsolate UI: reads the audit trail and nothing else"
      },
      {
        "name": "offline_access",
        "description": "Offline tokens: the CLI's login outlives the browser session"
      }
    ]
  },
